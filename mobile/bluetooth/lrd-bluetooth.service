[Unit]
Description=LibreDroid Sovereign Bluetooth & BLE Privacy Daemon
Documentation=man:lrd-bluetooth(1)
After=dbus.service bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/lrd-bluetoothd
Restart=always
RestartSec=2s
KillMode=process
StandardOutput=journal
StandardError=journal

# Sandboxing & Hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/libredroid /tmp/libredroid
PrivateTmp=false
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
