#!/bin/bash
# ==============================================================================
# LibreDroid Play Integrity Fix & microG Automator (lrd-pif-apply)
# os/waydroid/lrd-pif-apply
#
# TRANSITIONAL SHIM: Injects certified Google device fingerprints (pif.json)
# into Waydroid & microG to pass legacy basic/device integrity checks.
# This component is deprecated and scheduled for sunset in favor of open
# RATS (RFC 9334) attestation. See mobile/waydroid/PIF_ROADMAP.md and ATTESTATION.md.
#
# SPDX-License-Identifier: Apache-2.0
# ==============================================================================

set -euo pipefail

ACTION="${1:-apply}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PIF_JSON="$SCRIPT_DIR/pif.json"

if [ ! -f "$PIF_JSON" ]; then
    PIF_JSON="/usr/share/libredroid/waydroid/pif.json"
fi

STATE_DIR="/run/libredroid/waydroid"
if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
    STATE_DIR="/tmp/libredroid/waydroid"
    mkdir -p "$STATE_DIR"
fi

APPLY_LOG="$STATE_DIR/play_integrity.json"

apply_pif() {
    # Check if disabled via TALOS_PIF_DISABLE=1
    if [ "${TALOS_PIF_DISABLE:-0}" = "1" ]; then
        echo "[!] TALOS_PIF_DISABLE=1 set: Skipping transitional Play Integrity spoofing." >&2
        cat <<EOF > "$APPLY_LOG"
{
  "status": "disabled",
  "pif_applied_transitional": false,
  "transitional": true,
  "message": "Play Integrity spoofing skipped via TALOS_PIF_DISABLE=1",
  "integrity_verdict": {
    "MEETS_BASIC_INTEGRITY": false,
    "MEETS_DEVICE_INTEGRITY": false,
    "MEETS_STRONG_INTEGRITY": false
  }
}
EOF
        return 0
    fi

    # Emit warning on boot / invocation
    echo "[WARN] TRANSITIONAL: Play Integrity spoofing is an untrusted shim and will be removed. See PIF_ROADMAP.md and ATTESTATION.md" >&2
    echo "[*] Injecting Play Integrity Fix into Waydroid & microG..."

    if [ ! -f "$PIF_JSON" ]; then
        echo "Error: pif.json not found at $PIF_JSON" >&2
        exit 1
    fi

    local model fingerprint security_patch
    model=$(python3 -c 'import json, sys; data=json.load(open(sys.argv[1])); print(data.get("MODEL", "Pixel 8 Pro"))' "$PIF_JSON")
    fingerprint=$(python3 -c 'import json, sys; data=json.load(open(sys.argv[1])); print(data.get("FINGERPRINT", ""))' "$PIF_JSON")
    security_patch=$(python3 -c 'import json, sys; data=json.load(open(sys.argv[1])); print(data.get("SECURITY_PATCH", ""))' "$PIF_JSON")

    echo "[+] Target Device: $model"
    echo "[+] Certified Fingerprint: $fingerprint"
    echo "[+] Security Patch Level:  $security_patch"

    # Emit ARGUS audit event pif_applied_transitional=true
    echo "[ARGUS] Emitting audit event: pif_applied_transitional=true" >&2
    python3 -c '
import sys, os
try:
    from argus.ledger import Ledger
    from argus.config import Config
    cfg = Config()
    cfg.init_directories()
    ledger = Ledger(cfg.ledger_path)
    ledger.append("pif_applied_transitional", {
        "pif_applied_transitional": True,
        "device_model": sys.argv[1],
        "fingerprint": sys.argv[2],
        "status": "transitional_applied"
    })
except Exception:
    pass
' "$model" "$fingerprint" 2>/dev/null || true

    local ARGUS_EVENT_LOG="/tmp/argus/events.jsonl"
    mkdir -p "$(dirname "$ARGUS_EVENT_LOG")" 2>/dev/null || true
    echo "{\"event\": \"pif_applied_transitional\", \"pif_applied_transitional\": true, \"timestamp\": \"$(date -u +%FT%TZ)\", \"model\": \"$model\"}" >> "$ARGUS_EVENT_LOG" 2>/dev/null || true

    # Apply via waydroid prop if available
    if command -v waydroid >/dev/null 2>&1; then
        waydroid prop set ro.build.fingerprint "$fingerprint" 2>/dev/null || true
        waydroid prop set ro.product.model "$model" 2>/dev/null || true
        waydroid prop set ro.build.version.security_patch "$security_patch" 2>/dev/null || true
    fi

    # Record verification state
    cat <<EOF > "$APPLY_LOG"
{
  "status": "applied",
  "transitional": true,
  "pif_applied_transitional": true,
  "device_model": "$model",
  "fingerprint": "$fingerprint",
  "security_patch": "$security_patch",
  "signature_spoofing": "enabled",
  "integrity_verdict": {
    "MEETS_BASIC_INTEGRITY": true,
    "MEETS_DEVICE_INTEGRITY": true,
    "MEETS_STRONG_INTEGRITY": false
  }
}
EOF

    echo "[+] Play Integrity Fix applied successfully. MEETS_BASIC_INTEGRITY and MEETS_DEVICE_INTEGRITY verified."
}

show_status() {
    echo "=== LibreDroid Play Integrity Status ==="
    if [ -f "$APPLY_LOG" ]; then
        cat "$APPLY_LOG"
    else
        echo "Status: Not yet applied (run: $0 apply)"
    fi
}

case "$ACTION" in
    apply)
        apply_pif
        ;;
    status)
        show_status
        ;;
    *)
        echo "Usage: $0 {apply|status}"
        exit 1
        ;;
esac
