# Build & test caches
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.coverage
.deps/
node_modules/
build_tmp/
*.o
out/
# Cryptographic secret keys and certificates
store/keys/*.sec
store/keys/*.pem
store/keys/*.key
*.sec
*.pem
*.key

# Preserve non-sensitive public test fixtures (allowlisted in .keyguard-allow)
!tests/argx/fixtures/**

# Large generated disk images (500MB+ sparse ext4 release images)
*.img
*.iso
mobile/output/*.img
mobile/treble/output/*.img
mobile/release/*.img
