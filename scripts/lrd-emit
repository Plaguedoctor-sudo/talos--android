#!/usr/bin/env bash
# ==============================================================================
# LibreDroid Sovereign Event Bus Emitter (lrd-emit)
# Dispatches asynchronous power, sensor, thermal, and security events to UI shell.
# ==============================================================================
set -euo pipefail

EVENT_TYPE="${1:-generic}"
PAYLOAD="${2:-{}}"

RUN_DIR="/run/libredroid"
if ! mkdir -p "$RUN_DIR" 2>/dev/null; then
    RUN_DIR="/tmp/libredroid"
    mkdir -p "$RUN_DIR" 2>/dev/null || true
fi

EVENT_LOG="$RUN_DIR/events.jsonl"
EVENT_FIFO="$RUN_DIR/events.fifo"
SOCK_PATH="$RUN_DIR/events.sock"

TIMESTAMP="$(date -u +%FT%TZ)"
RECORD="{\"timestamp\":\"$TIMESTAMP\",\"type\":\"$EVENT_TYPE\",\"payload\":$PAYLOAD}"

# 1. Append to in-memory event stream
echo "$RECORD" >> "$EVENT_LOG" 2>/dev/null || true

# 2. Pipe to FIFO if listener is open
if [ -p "$EVENT_FIFO" ]; then
    echo "$RECORD" > "$EVENT_FIFO" 2>/dev/null || true
fi

# 3. Relay via UNIX socket if active
if [ -S "$SOCK_PATH" ] && command -v nc >/dev/null 2>&1; then
    echo "$RECORD" | nc -U "$SOCK_PATH" 2>/dev/null || true
fi

echo "[lrd-emit] Dispatched '$EVENT_TYPE' event."
